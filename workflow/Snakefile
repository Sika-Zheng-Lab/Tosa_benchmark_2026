import os

# Resolve config path relative to the Snakefile location so the pipeline
# can be launched from any working directory.
configfile: os.path.join(workflow.basedir, "..", "config", "config.yaml")

# ---------------------------------------------------------------------------
# Helper variables
# ---------------------------------------------------------------------------

OUTDIR = config.get("outdir", "results")

# Set working directory to output directory so .snakemake/ (including
# Singularity images) is stored inside it.
workdir: OUTDIR

SAMPLES = [
    s for s in config["samples"].keys()
    if config["samples"][s] is not None and "R1" in config["samples"][s]
]
ALL_SAMPLES = SAMPLES + ["simulation"]

# ---------------------------------------------------------------------------
# Singularity bind paths — collect from config and build --bind argument
# ---------------------------------------------------------------------------

def _collect_bind_paths():
    """Gather all directories that Singularity containers need to access."""
    paths = set()
    # Output directory
    if os.path.isabs(OUTDIR):
        paths.add(OUTDIR)
    # STAR index
    si = config.get("star_index", "")
    if si and os.path.isabs(si):
        paths.add(si)
    # GTF annotation
    gtf = config.get("gtf", "")
    if gtf and os.path.isabs(gtf):
        paths.add(os.path.dirname(gtf))
    # FASTQ directories
    for s, info in config.get("samples", {}).items():
        if info is None:
            continue
        for key in ("R1", "R2"):
            fq = info.get(key, "")
            if fq and os.path.isabs(fq):
                paths.add(os.path.dirname(fq))
    # Explicit extra bind paths from config
    for p in config.get("singularity_bind_paths", []):
        if p:
            paths.add(p)
    return sorted(paths)

_BIND_PATHS = _collect_bind_paths()
SINGULARITY_ARGS = " ".join(f"--bind {p}" for p in _BIND_PATHS) if _BIND_PATHS else ""

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

def is_paired(sample):
    """Return True if sample has R2 FASTQ."""
    if sample == "simulation":
        return True
    sample_cfg = config["samples"].get(sample)
    if sample_cfg is None:
        return False
    return "R2" in sample_cfg


def get_star_index(sample):
    """Return STAR index directory for the given sample."""
    if sample == "simulation":
        return "simulation/star_index"
    return config["star_index"]


def get_strandedness_tosa(wildcards):
    """Return strand flag for Tosa."""
    s = config.get("strandedness")
    if s:
        return f"--strand {s}"
    return ""


def get_strandedness_regtools(wildcards):
    """Return strand flag for regtools."""
    s = config.get("strandedness")
    if s:
        return s
    # Default: use XS tags when available (STAR adds them)
    return "XS"


def get_strandedness_featurecounts(wildcards):
    """Return strand code for featureCounts (-s).

    featureCounts strand codes: 0=unstranded, 1=stranded (FR), 2=reversely stranded (RF).
    """
    s = config.get("strandedness")
    if s is None:
        return 0
    mapping = {"RF": 2, "FR": 1, "XS": 0}
    return mapping.get(s, 0)


def get_gtf(sample):
    """Return GTF annotation path for the given sample."""
    if sample == "simulation":
        return "simulation/reference/annotation.gtf"
    return config["gtf"]


