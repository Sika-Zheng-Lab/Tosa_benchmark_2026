rule export_paper_figures:
    """Copy main pipeline figures to the project figures/ directory."""
    input:
        fig4="eib_benchmark/evaluation/accuracy_heatmap.png",
        fig5ab=expand(
            "scrna_comparison/{scrna_sample}_downsample_benchmark.png",
            scrna_sample=SCRNA_SAMPLES,
        ),
        fig5c=expand(
            "scrna_comparison/{scrna_sample}_per_cell_concordance.png",
            scrna_sample=SCRNA_SAMPLES,
        ),
        fig5d="scrna_comparison/simulation_accuracy_plot.png",
        fig5e=expand(
            "scrna_comparison/{scrna_sample}_tosa_vs_starsolo_scatter.png",
            scrna_sample=SCRNA_SAMPLES,
        ),
        fig5f="scrna_eib_benchmark/evaluation/accuracy_by_anchor_length.png",
        fig5g="scrna_eib_benchmark/evaluation/per_cell_accuracy.png",
    output:
        fig4=os.path.join(PAPER_DIR, "Figure4.png"),
        fig5ab=os.path.join(PAPER_DIR, "Figure5AB.png"),
        fig5c=os.path.join(PAPER_DIR, "Figure5C.png"),
        fig5d=os.path.join(PAPER_DIR, "Figure5D.png"),
        fig5e=os.path.join(PAPER_DIR, "Figure5E.png"),
        fig5f=os.path.join(PAPER_DIR, "Figure5F.png"),
        fig5g=os.path.join(PAPER_DIR, "Figure5G.png"),
    run:
        import shutil, os
        os.makedirs(PAPER_DIR, exist_ok=True)
        shutil.copy2(input.fig4, output.fig4)
        fig5ab_src = input.fig5ab[0] if isinstance(input.fig5ab, list) else input.fig5ab
        shutil.copy2(fig5ab_src, output.fig5ab)
        fig5c_src = input.fig5c[0] if isinstance(input.fig5c, list) else input.fig5c
        shutil.copy2(fig5c_src, output.fig5c)
        shutil.copy2(input.fig5d, output.fig5d)
        fig5e_src = input.fig5e[0] if isinstance(input.fig5e, list) else input.fig5e
        shutil.copy2(fig5e_src, output.fig5e)
        shutil.copy2(input.fig5f, output.fig5f)
        shutil.copy2(input.fig5g, output.fig5g)
