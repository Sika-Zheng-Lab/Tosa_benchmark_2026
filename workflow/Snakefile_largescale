EXPERIMENT_TABLE = pd.read_csv(config["experiment_table"], sep="\t")
SAMPLES = EXPERIMENT_TABLE["sample"].tolist()
BAM_DICT = dict(zip(EXPERIMENT_TABLE["sample"], EXPERIMENT_TABLE["bam"]))

# ---------------------------------------------------------------------------
# Singularity bind paths
# ---------------------------------------------------------------------------

def _collect_bind_paths():
    """Gather all directories that Singularity containers need to access."""
    paths = set()
    # Output directory
    if os.path.isabs(OUTDIR):
        paths.add(OUTDIR)
    # GTF annotation directory
    gtf = config.get("gtf", "")
    if gtf and os.path.isabs(gtf):
        paths.add(os.path.dirname(gtf))
    # BAM file directories
    for bam in BAM_DICT.values():
        if bam and os.path.isabs(bam):
            paths.add(os.path.dirname(bam))
    # Explicit extra bind paths
    for p in config.get("singularity_bind_paths", []):
        if p:
            paths.add(p)
    return sorted(paths)

_BIND_PATHS = _collect_bind_paths()
SINGULARITY_ARGS = " ".join(f"--bind {p}" for p in _BIND_PATHS) if _BIND_PATHS else ""

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

def get_bam(wildcards):
    """Return BAM path for a given sample."""
    return BAM_DICT[wildcards.sample]

def get_bai(wildcards):
    """Return BAI path for a given sample (assumes .bam.bai exists)."""
    return BAM_DICT[wildcards.sample] + ".bai"

def get_star_sj(wildcards):
    """Return STAR SJ.out.tab path derived from BAM path."""
    bam = BAM_DICT[wildcards.sample]
    return bam.replace("_Aligned.out.bam", "_SJ.out.tab")

def get_strandedness_tosa():
    """Return strand flag for Tosa."""
    s = config.get("strandedness")
    if s:
        return f"--strand {s}"
    return ""

def get_strandedness_featurecounts():
    """Return strand code for featureCounts (-s)."""
    s = config.get("strandedness")
    if s is None:
        return 0
    mapping = {"RF": 2, "FR": 1, "XS": 0}
    return mapping.get(s, 0)

TOSA_STRAND = get_strandedness_tosa()
FC_STRAND = get_strandedness_featurecounts()
